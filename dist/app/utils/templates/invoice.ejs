<div
    style="font-family: Arial, sans-serif; color: #333; margin: 20px; border: 1px solid #ddd; padding: 20px; border-radius: 10px; background-color: #f9f9f9;">
    <h2 style="text-align: center; color: #4CAF50;">Tour Booking Invoice</h2>
    <hr style="border: 1px solid #ddd; margin: 20px 0;">

    <p><strong style="color: #555;">Customer:</strong> <span style="color: #777;">
            <%= customerName ?? 'N/A' %>
        </span></p>
    <p><strong style="color: #555;">Tour:</strong> <span style="color: #777;">
            <%= tourName ?? 'N/A' %>
        </span></p>
    <p><strong style="color: #555;">Guests:</strong> <span style="color: #777;">
            <%= guestCount ?? 0 %>
        </span></p>

    <p><strong style="color: #555;">Booking Date:</strong> <span style="color: #777;">
            <%= date ? new Date(date).toLocaleDateString() : 'N/A' %>
        </span></p>
    <p><strong style="color: #555;">Payment ID:</strong> <span style="color: #777;">
            <%= paymentId ?? 'N/A' %>
        </span></p>

    <p style="font-size: 1.2em; font-weight: bold; color: #333;">
        <strong>Total Amount Paid:</strong> $<%= amount ? amount.toFixed(2) : '0.00' %>
    </p>

    <hr style="border: 1px solid #ddd; margin: 20px 0;">

    <p style="text-align: center; font-size: 0.9em; color: #aaa;">Thank you for booking with us! We hope you have an
        amazing experience.</p>
</div>